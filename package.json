{
  "name": "snapclaw",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:client": "esbuild src/client/setup.ts --bundle --minify --outfile=public/setup.js --format=iife --target=es2020",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "start": "node dist/index.js",
    "test": "npm run build:server && node --test test/upgrade.test.mjs test/sync.test.mjs"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
